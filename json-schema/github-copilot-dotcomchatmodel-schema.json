{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DotcomChatModel",
  "title": "DotcomChatModel",
  "type": "object",
  "description": "Dotcom Chat metrics for a specific AI model.",
  "properties": {
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "is_custom_model": {
      "type": "boolean",
      "example": true
    },
    "custom_model_training_date": {
      "type": [
        "string",
        "null"
      ],
      "example": "example_value"
    },
    "total_engaged_users": {
      "type": "integer",
      "example": 10
    },
    "total_chats": {
      "type": "integer",
      "example": 10
    }
  }
}